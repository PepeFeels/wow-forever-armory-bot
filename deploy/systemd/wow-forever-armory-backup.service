[Unit]
Description=Create a verified WoW Forever Armory SQLite backup
After=local-fs.target

[Service]
Type=oneshot
TimeoutStartSec=30min
TimeoutStopSec=30s
User=wow-armory
Group=wow-armory
WorkingDirectory=/opt/wow-forever-armory-bot/current
EnvironmentFile=/etc/wow-forever-armory-bot/config
Environment=ARMORY_DATABASE_PATH=/var/lib/wow-forever-armory-bot/guild-armory.sqlite3
Environment=ARMORY_BACKUP_DIR=/var/lib/wow-forever-armory-bot/backups
Environment=ARMORY_BACKUP_RETENTION=14
StateDirectory=wow-forever-armory-bot
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/wow-forever-armory-bot/current/.venv/bin/python -m wow_forever_armory.operations backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/wow-forever-armory-bot
