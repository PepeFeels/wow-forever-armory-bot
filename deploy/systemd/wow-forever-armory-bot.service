[Unit]
Description=WoW Forever Armory Discord Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=wow-armory
Group=wow-armory
WorkingDirectory=/opt/wow-forever-armory-bot/current
EnvironmentFile=/etc/wow-forever-armory-bot/config
Environment=ARMORY_DATABASE_PATH=/var/lib/wow-forever-armory-bot/guild-armory.sqlite3
Environment=ARMORY_BACKUP_DIR=/var/lib/wow-forever-armory-bot/backups
Environment=ARMORY_PYTHON=/opt/wow-forever-armory-bot/current/.venv/bin/python
LoadCredential=discord-token:/etc/wow-forever-armory-bot/discord-token
StateDirectory=wow-forever-armory-bot
StateDirectoryMode=0700
UMask=0077
ExecStartPre=+/opt/wow-forever-armory-bot/bin/armory-db-preflight
ExecStart=/opt/wow-forever-armory-bot/bin/armory-launch
Restart=on-failure
RestartSec=10s
KillSignal=SIGINT
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/wow-forever-armory-bot

[Install]
WantedBy=multi-user.target
